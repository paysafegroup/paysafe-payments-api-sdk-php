# Paysafe API credentials
# Your API key in format: username:password
# Get these from the Paysafe merchant portal (Integration > API Keys)
PAYSAFE_API_KEY=your-api-key-here

# Your account ID from the Paysafe merchant portal
PAYSAFE_ACCOUNT_ID=your-account-id-here

# Return URL configuration
# After a payment redirect (e.g. 3DS, PayPal), Paysafe will redirect the customer back to this base URL.
# Must match the URL you use to access the app in your browser.
PAYSAFE_RETURN_URL_BASE=http://127.0.0.1:8888

# SDK logging configuration for the demo
# Allowed values: ERROR, ALL
PAYSAFE_LOG_LEVEL=ERROR

